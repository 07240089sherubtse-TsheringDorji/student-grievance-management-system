<%- include('partials/header',{title:'Change password'}) %><section class="card form-card"><div class="eyebrow">Account security</div><h1>Change password</h1>
<% if(currentUser.must_change_password){ %><div class="alert error">You must set a new password before continuing.</div><% } %>
<% if(error){ %><div class="alert error"><%= error %></div><% } %>
<form method="post" action="/change-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="field"><label for="current_password">Current password</label><input id="current_password" name="current_password" type="password" required autocomplete="current-password"></div>
<div class="field"><label for="new_password">New password</label><input id="new_password" name="new_password" type="password" required minlength="8" autocomplete="new-password"><small class="muted">At least 8 characters, with a letter and a number.</small></div>
<div class="field"><label for="confirm_password">Confirm new password</label><input id="confirm_password" name="confirm_password" type="password" required minlength="8" autocomplete="new-password"></div>
<button class="btn teal" type="submit">Update password</button></form></section><%- include('partials/footer') %>
