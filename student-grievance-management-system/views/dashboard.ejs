<%- include('partials/header', { title: 'Student dashboard' }) %>

<div class="section-head">
  <div>
    <div class="eyebrow">Student workspace</div>
    <h1>Your dashboard</h1>
    <p class="muted">View your submissions and follow their progress.</p>
  </div>
  <a class="btn teal" href="/grievances/new">＋ Submit grievance</a>
</div>

<div class="grid">
  <div class="card">
    <div class="muted">Total submitted</div>
    <div class="stat"><%= items.length %></div>
  </div>
  <div class="card">
    <div class="muted">In progress</div>
    <div class="stat">
      <%= items.filter(g => !['RESOLVED', 'CLOSED'].includes(g.status)).length %>
    </div>
  </div>
  <div class="card">
    <div class="muted">Resolved or closed</div>
    <div class="stat">
      <%= items.filter(g => ['RESOLVED', 'CLOSED'].includes(g.status)).length %>
    </div>
  </div>
</div>

<div class="section-head">
  <h2>My grievances</h2>
</div>

<% if (!items.length) { %>
  <div class="card empty">
    <h3>No grievances yet</h3>
    <p>When you submit a concern, it will appear here.</p>
    <a class="btn" href="/grievances/new">Submit your first grievance</a>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Reference ID</th>
          <th>Title</th>
          <th>Category</th>
          <th>Status</th>
          <th>Submitted</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(g => { %>
          <tr>
            <td>
              <span class="ref-id"><%= g.reference_id %></span>
            </td>
            <td><%= g.title %></td>
            <td><%= g.category_name %></td>
            <td>
              <span class="pill <%= g.status.toLowerCase().replaceAll(' ', '-') %>">
                <%= g.status %>
              </span>
            </td>
            <td><%= new Date(g.created_at).toLocaleDateString() %></td>
            <td>
              <a href="/grievances/<%= g.grievance_id %>">View details →</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (notifications.length) { %>
  <div class="section-head">
    <h2>Recent notifications</h2>
  </div>
  <div class="card">
    <% notifications.forEach(n => { %>
      <p>
        <%= n.message %>
        <span class="muted">· <%= new Date(n.created_at).toLocaleString() %></span>
      </p>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>