<%- include('partials/header',{title:'Administrator dashboard'}) %><div class="section-head"><div><div class="eyebrow">Administration</div><h1>Grievance management</h1><p class="muted">Review, assign, update and respond to student grievances.</p></div></div><div class="grid"><div class="card"><div class="muted">All grievances</div><div class="stat"><%= stats.total %></div></div><div class="card"><div class="muted">Awaiting review</div><div class="stat"><%= stats.pending %></div></div><div class="card"><div class="muted">Resolved / closed</div><div class="stat"><%= stats.resolved+stats.closed %></div></div></div><div class="section-head"><h2>All cases</h2><form class="filters" method="get" action="/admin"><input name="search" value="<%= search %>" placeholder="Search title, reference or student"><select name="status"><option value="">All statuses</option><% allowed.forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="btn" type="submit">Filter</button><a href="/admin">Reset</a></form></div><% if(!items.length){ %><div class="card empty">No grievances match these filters.</div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Reference / Student</th><th>Grievance</th><th>Category</th><th>Department</th><th>Status</th><th>Submitted</th><th>Manage</th></tr></thead><tbody><% items.forEach(g=>{ %><tr><td><span class="ref-id"><%= g.reference_id %></span><br><span class="muted"><%= g.student_name %><br><%= g.student_email %></span></td><td><%= g.title %></td><td><%= g.category_name %></td><td><%= g.department_name||'Unassigned' %></td><td><span class="pill <%= g.status.toLowerCase().replaceAll(' ','-') %>"><%= g.status %></span></td><td><%= new Date(g.created_at).toLocaleDateString() %></td><td><a class="btn small" href="/grievances/<%= g.grievance_id %>">Open case</a></td></tr><% }) %></tbody></table></div><% } %><%- include('partials/footer') %>