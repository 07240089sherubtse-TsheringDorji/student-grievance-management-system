<%- include('partials/header', { title: 'Department dashboard' }) %>

<div class="section-head">
  <div>
    <div class="eyebrow">Department workspace</div>
    <h1><%= department ? department.department_name : 'Department' %></h1>
    <p class="muted">
      Grievances assigned to your department. You can update progress and respond to students.
    </p>
  </div>
</div>

<div class="grid">
  <div class="card">
    <div class="muted">Assigned to us</div>
    <div class="stat"><%= stats.total %></div>
  </div>
  <div class="card">
    <div class="muted">Awaiting action</div>
    <div class="stat"><%= stats.pending %></div>
  </div>
  <div class="card">
    <div class="muted">In progress</div>
    <div class="stat"><%= stats.in_progress %></div>
  </div>
</div>

<div class="section-head">
  <h2>Our cases</h2>
  <form class="filters" method="get" action="/department">
    <input name="search" value="<%= search %>" placeholder="Search title or reference">
    <select name="status">
      <option value="">All statuses</option>
      <% ['ASSIGNED', 'IN PROGRESS', 'RESOLVED', 'CLOSED'].forEach(s => { %>
        <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <button class="btn" type="submit">Filter</button>
    <a href="/department">Reset</a>
  </form>
</div>

<% if (!items.length) { %>
  <div class="card empty">
    No grievances are assigned to your department yet.
  </div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Reference / Student</th>
          <th>Grievance</th>
          <th>Category</th>
          <th>Status</th>
          <th>Submitted</th>
          <th>Manage</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(g => { %>
          <tr>
            <td>
              <span class="ref-id"><%= g.reference_id %></span><br>
              <span class="muted"><%= g.student_name %></span>
            </td>
            <td><%= g.title %></td>
            <td><%= g.category_name %></td>
            <td>
              <span class="pill <%= g.status.toLowerCase().replaceAll(' ', '-') %>">
                <%= g.status %>
              </span>
            </td>
            <td><%= new Date(g.created_at).toLocaleDateString() %></td>
            <td>
              <a class="btn small" href="/grievances/<%= g.grievance_id %>">Open case</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (notifications.length) { %>
  <div class="section-head">
    <h2>Recent notifications</h2>
  </div>
  <div class="card">
    <% notifications.forEach(n => { %>
      <p>
        <%= n.message %> 
        <span class="muted">· <%= new Date(n.created_at).toLocaleString() %></span>
      </p>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>