<%- include('partials/header',{title:'Grievance details'}) %><div class="section-head"><div><a href="<%= homePath %>">← Back to dashboard</a><h1 style="margin-bottom:4px">Grievance details</h1><p class="muted">Reference ID: <span class="ref-id lg"><%= item.reference_id %></span></p></div><span class="pill <%= item.status.toLowerCase().replaceAll(' ','-') %>"><%= item.status %></span></div><div class="two-col"><section class="card"><div class="eyebrow"><%= item.category_name %></div><h2><%= item.title %></h2><p style="white-space:pre-wrap"><%= item.description %></p><hr style="border:0;border-top:1px solid #e2e8f0;margin:22px 0"><p class="muted">Submitted <%= new Date(item.created_at).toLocaleString() %></p><p><strong>Department:</strong> <%= item.department_name||'Not assigned yet' %></p><% if(item.admin_response){ %><h3>Response</h3><div class="response-box"><%= item.admin_response %></div><% } %></section><section class="card"><h2>Grievance history</h2><% if(!history.length){ %><p class="muted">No updates recorded yet.</p><% }else{ %><div class="timeline"><% history.forEach(h=>{ %><div class="timeline-item"><strong><%= h.status||'Update' %></strong><p style="margin:5px 0"><%= h.comment %></p><small class="muted"><%= h.updated_by_name||'System' %> · <%= new Date(h.created_at).toLocaleString() %></small></div><% }) %></div><% } %></section></div><% if(currentUser.role==='admin'){ %><div class="section-head"><h2>Manage grievance</h2></div><div class="two-col"><section class="card"><h3>Update status</h3><form method="post" action="/admin/grievances/<%= item.grievance_id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="status">Status</label><select name="status" id="status"><% ['SUBMITTED','UNDER REVIEW','ASSIGNED','IN PROGRESS','RESOLVED','CLOSED'].forEach(s=>{ %><option <%= item.status===s?'selected':'' %>><%= s %></option><% }) %></select></div><button class="btn" type="submit">Save status</button></form></section><section class="card"><h3>Assign department</h3><form method="post" action="/admin/grievances/<%= item.grievance_id %>/assign"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="department_id">Department</label><select id="department_id" name="department_id" required><% departments.forEach(d=>{ %><option value="<%= d.department_id %>" <%= item.department_id===d.department_id?'selected':'' %>><%= d.department_name %></option><% }) %></select></div><button class="btn" type="submit">Assign department</button></form><h3 style="margin-top:24px">Add response</h3><form method="post" action="/admin/grievances/<%= item.grievance_id %>/respond"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="response">Response / remark</label><textarea name="response" id="response" required minlength="2" maxlength="3000"></textarea></div><button class="btn teal" type="submit">Save response</button></form></section></div>
<% } else if(currentUser.role==='department'){ %><div class="section-head"><h2>Work on this case</h2></div><div class="two-col"><section class="card"><h3>Update progress</h3><% if(item.status==='CLOSED'){ %><p class="muted">This grievance is closed. Contact an administrator to reopen it.</p><% }else{ %><form method="post" action="/department/grievances/<%= item.grievance_id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="status">Status</label><select name="status" id="status"><% ['IN PROGRESS','RESOLVED'].forEach(s=>{ %><option <%= item.status===s?'selected':'' %>><%= s %></option><% }) %></select></div><button class="btn" type="submit">Save status</button></form><% } %></section><section class="card"><h3>Respond to student</h3><form method="post" action="/department/grievances/<%= item.grievance_id %>/respond"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="field"><label for="response">Response / remark</label><textarea name="response" id="response" required minlength="2" maxlength="3000"></textarea></div><button class="btn teal" type="submit">Save response</button></form></section></div><% } %>
<%- include('partials/footer') %>